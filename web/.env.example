# Public Formspree form endpoint (not a secret). Create a form at formspree.io, then paste its URL.
# Example shape: https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=

# Optional: Cloudflare Turnstile SITE key (public). The SECRET key goes in the Formspree dashboard, never here.
VITE_TURNSTILE_SITE_KEY=
