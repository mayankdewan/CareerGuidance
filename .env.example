# Public Formspree form endpoint (not a secret). Create a form at formspree.io, then paste its URL.
# Example shape: https://formspree.io/f/xxxxxxxx
VITE_FORMSPREE_ENDPOINT=

# Optional: Cloudflare Turnstile SITE key (public). The SECRET key goes in the Formspree dashboard, never here.
VITE_TURNSTILE_SITE_KEY=

# Public site address, no trailing slash, e.g. https://www.example.com (or your *.pages.dev address).
# Enables canonical URLs, og:url, sitemap.xml and absolute URLs in structured data.
VITE_SITE_URL=

# Set to true to ask search engines NOT to index this deployment (e.g. while testing with placeholders).
VITE_NOINDEX=false
